# ------------------------------------------------------------------
# Backend environment variables
# Copy this file to `backend/.env` and fill in the values:
#   cp .env.example .env
# Never commit the real `.env` file.
# ------------------------------------------------------------------

# Port the Express server listens on.
# Must match the port used in the frontend's VITE_API_BASE_URL.
PORT=8000

# MongoDB connection string (local MongoDB or MongoDB Atlas). Required.
# Local example: mongodb://127.0.0.1:27017/interview-prep-ai
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview-prep-ai
MONGO_URI=mongodb://127.0.0.1:27017/interview-prep-ai

# Secret used to sign JWT auth tokens. Required.
# Use a long random string, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini API key. Required.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used for question and explanation generation. Optional.
# Defaults to gemini-3.1-flash-lite when not set.
GEMINI_MODEL=gemini-3.1-flash-lite

# Allowed origin(s) for CORS, comma-separated. Optional.
# Leave empty to allow all origins (fine for local development).
# Production example: https://your-frontend.vercel.app
CLIENT_URL=
