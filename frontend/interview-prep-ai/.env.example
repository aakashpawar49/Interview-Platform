# ------------------------------------------------------------------
# Frontend environment variables (Vite)
# Copy this file to `frontend/interview-prep-ai/.env` and adjust:
#   cp .env.example .env
# Only variables prefixed with VITE_ are exposed to the browser,
# so never put secrets in this file.
# Restart `npm run dev` after changing it.
# ------------------------------------------------------------------

# Base URL of the backend API (no trailing slash).
# Must match the backend's PORT for local development.
# If left empty: dev uses http://localhost:8000, production builds call
# the same origin (used when the backend serves the built frontend).
VITE_API_BASE_URL=http://localhost:8000
